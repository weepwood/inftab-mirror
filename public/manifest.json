{
  "manifest_version": 3,
  "name": "Inftab New Tab",
  "version": "1.0.0",
  "description": "A customizable new tab page with shortcuts, folders, notes, tasks, and weather.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "optional_permissions": [
    "bookmarks"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ]
}
